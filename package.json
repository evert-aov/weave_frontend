{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --stats-json",
    "postbuild": "node scripts/check-startup-bundle.mjs",
    "check:startup": "node scripts/check-startup-bundle.mjs",
    "test:startup": "node --test scripts/check-startup-bundle.spec.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "vendor:vim": "node scripts/vendor-monaco-vim.mjs",
    "vendor:codemirror": "node scripts/vendor-codemirror.mjs",
    "test:sheets": "ng test --watch=false --runner-config=vitest-spreadsheet.config.mts --include=\"**/pure-sheet-editor/**/*.spec.ts\""
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@monaco-editor/loader": "^1.7.0",
    "@ng-icons/core": "^35.0.1",
    "@ng-icons/lucide": "^35.0.1",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-task-item": "^3.31.4",
    "@tiptap/extension-task-list": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@types/katex": "^0.16.8",
    "dompurify": "3.4.16",
    "exceljs": "^4.4.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "katex": "^0.19.0",
    "marked": "16.4.2",
    "mermaid": "^12.1.0",
    "monaco-editor": "^0.57.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "fflate": "0.8.3",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.0",
    "@tailwindcss/postcss": "^4.1.12",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.29",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "emf-converter": "1.6.0"
  }
}
